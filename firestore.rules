rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. USERS COLLECTION
    match /users/{userId} {
      allow read: if request.auth != null;
      // Allow users to update their own profile (and create it on first login)
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Chat Settings (wallpapers, etc.) - users can only access their own
      match /chatSettings/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Starred Messages - users manage their own stars
      match /starredMessages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Scheduled Messages - users manage their own scheduled messages
      match /scheduled_messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // 2. CHATS COLLECTION (Direct & Groups)
    match /chats/{chatId} {
      // ALLOW CREATE: If user is logged in AND includes themselves in the 'members' array
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      
      // ALLOW READ/UPDATE: If user is already in the 'members' array
      allow read, update: if request.auth != null && request.auth.uid in resource.data.members;
      
      // ALLOW DELETE: (Optional) Usually better to archive, but this works for now
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;

      // 3. MESSAGES SUB-COLLECTION
      match /messages/{messageId} {
        // READ/CREATE: We must check the PARENT document (the chat) to see if the user is a member.
        // Note: This costs 1 extra read per evaluation, but it secures the data.
        allow read, create, update: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        
        // DELETE: Only allow the original sender to delete their message
        allow delete: if request.auth != null && resource.data.sender == request.auth.uid; 
      }

      // 4. TYPING INDICATOR
      match /typing/{userId} {
        allow read, write: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }

    // 5. CALLS COLLECTION (Video/Audio Calling)
    match /calls/{callId} {
      // Allow read (get + list) for authenticated users
      // - get: needed to check if call exists before creating
      // - list: needed for incoming call queries
      allow read: if request.auth != null;
      
      // Allow create if user is the caller
      allow create: if request.auth != null && 
        request.resource.data.callerId == request.auth.uid;
      
      // Allow update if user is caller or receiver
      allow update: if request.auth != null && 
        (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      
      // Allow delete if user is caller or receiver
      allow delete: if request.auth != null && 
        (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid);

      // ICE Candidates subcollection
      match /iceCandidates/{candidateId} {
        // Allow all operations for authenticated users in a call
        allow read, write: if request.auth != null;
      }
    }

    // 6. CALL LOGS COLLECTION (Persistent Call History)
    match /callLogs/{logId} {
      // Read: only if you are a participant
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      // Create: any authenticated user can log a call
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      // Delete: allow participants to delete their own logs
      allow delete: if request.auth != null && request.auth.uid in resource.data.participants;
    }
  }
}
