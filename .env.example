# ConnectHub Client Environment Variables Template
# Copy this file to '.env.local' and fill in your values. Do not commit your actual values to Git.

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Local AI Server Base URL (FastAPI backend)
# Local development default: http://localhost:8000
# Production build default: Your secure ngrok public URL (e.g., https://abcd-12-34.ngrok-free.app)
VITE_AI_BASE_URL=http://localhost:8000
